APP_NAME="SmartCampus AI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Debe ser la dirección con la que abres el sistema: los enlaces de los correos se arman con ella.
APP_URL=http://127.0.0.1:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# --- Base de datos (MySQL de XAMPP). Crea antes una base vacía llamada "smartcampus" ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=smartcampus
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
CACHE_STORE=database
QUEUE_CONNECTION=sync

# --- Correo ---
# MAIL_MAILER=log  -> no envía nada: escribe los correos en storage/logs/laravel.log (ideal para probar).
# MAIL_MAILER=smtp -> envía correos reales con Gmail (ver README, sección "Correos reales").
MAIL_MAILER=log
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="SmartCampus AI"

# --- Administrador inicial (lo crea: php artisan migrate --seed) ---
# El correo debe ser REAL y tuyo: ahí llegan los enlaces de recuperación.
SC_ADMIN_EMAIL=
SC_ADMIN_NOMBRE="Administrador"
SC_ADMIN_CLAVE=Admin2026*

# --- Opcionales ---
# SC_DOMINIOS_CORREO=gmail.com     (solo permitir esos dominios; vacío = cualquiera)
# SC_CSP=true                      (política de seguridad de contenido; false solo para depurar)
